
{
    "parserOptions": {
        "ecmaVersion": 6,
        "sourceType": "module"
    },
    "env": {
      "browser": true,
      "node": true,
      "es6": true
    },
    "rules": {
        "semi": "error",
        "no-undef": "error",
        "no-unused-vars": "error",
        "no-shadow": "error"
    },
    "overrides": [
        {
            "files": ["test/gridfield.js"],
            "parserOptions": { "ecmaVersion": 2020 }
        },
        {
            "files": ["modules/**/*.js"],
            "parserOptions": { "ecmaVersion": 2021 },
            "env": { "es2021": true },
            "globals": {
                "GPUBufferUsage": "readonly",
                "GPUMapMode": "readonly",
                "GPUShaderStage": "readonly"
            }
        }
    ]
}